{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thorax.local/schema/thorax-config.schema.json",
  "title": "Thorax configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataDirectory", "server", "codex", "memory"],
  "properties": {
    "dataDirectory": { "type": "string", "minLength": 1 },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": { "const": "127.0.0.1" },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 }
      }
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "approvalPolicy", "sandbox"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "approvalPolicy": { "enum": ["untrusted", "on-request", "never"] },
        "sandbox": { "enum": ["read-only", "workspace-write", "danger-full-access"] }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["autoStageEphemeral", "reflectionIntervalMinutes"],
      "properties": {
        "autoStageEphemeral": { "type": "boolean" },
        "reflectionIntervalMinutes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}

